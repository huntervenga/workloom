# Local development only: synthetic values, no secrets. Copy with `cp .env.example .env`.
# Root dev:api, start and db:* scripts load this file; variables already set in the environment win.
# Local identity modes remain loopback-only; hosted configuration is explicit and shared-only.
# AUTH_MODE=dev must never be exposed publicly.
# NODE_ENV is set by the npm scripts (or explicitly for the production-build smoke), not here.

APP_ENV=local
AUTH_MODE=dev

# API listens on loopback only. The web dev server (127.0.0.1:4311) proxies /api to this port.
HOST=127.0.0.1
PORT=4310

# Matches infra/docker/compose.yaml (npm run db:up).
DATABASE_URL=postgres://workloom:workloom_local@127.0.0.1:54329/workloom

# Allowlisted fixture actor from the demo seed (npm run db:seed:demo).
DEV_ACTOR_ID=5eed0000-0000-4000-8000-000000000101

# Integration tests do not read this file: export TEST_DATABASE_URL for a separate
# *_test / workloom_test database. It must never point at DATABASE_URL.

# Optional LOCAL shared Auth mode (accepted be63752): see docs/76-shared-auth-local.md.
# Keep AUTH_MODE=dev above unless intentionally switching this API to shared.
# AUTH_MODE=shared
# AUTH_BASE_URL=https://auth.pavelignatov.com
# AUTH_ISSUER=https://auth.pavelignatov.com
# AUTH_AUDIENCE=pet-projects
# Origin only; the server constructs /app/auth/callback. Use compiled 4310, not dev 4311.
# AUTH_APP_ORIGIN=http://127.0.0.1:4310
# Server-only: replace this placeholder with 32 random bytes encoded as unpadded base64url.
# Preserve the key across API restarts. Never use an Auth client secret or analytics sk here.
# AUTH_SESSION_KEY=<server-only-43-character-base64url-key>

# Hosted operator template: inject these in the hosting service, NOT this local file.
# APP_ENV=staging  # or production; NODE_ENV=production is also required.
# AUTH_MODE=shared
# HOST=0.0.0.0
# PORT=8080  # Railway injects PORT.
# AUTH_APP_ORIGIN=https://workloom.pavelignatov.com
# AUTH_BASE_URL=https://auth.pavelignatov.com
# AUTH_ISSUER=https://auth.pavelignatov.com
# AUTH_AUDIENCE=pet-projects
# AUTH_SESSION_KEY=<server-only-43-character-base64url-key>
# DATABASE_URL=<remote-PostgreSQL-URL-with-sslmode=verify-full>
# Only exact *.railway.internal database hosts may omit sslmode on the private network.
# Do not set DEV_ACTOR_ID, PG* connection overrides or NODE_TLS_REJECT_UNAUTHORIZED=0 in hosted mode.
# No Auth client_secret or analytics secret is needed for login.

# Optional task attachments. Missing/incomplete settings disable uploads; the API still starts.
# Keep this bucket private. See docs/130-task-attachments.md for permissions and provider setup.
# The same optional bucket also stores profile photos under avatars/. Allow that prefix in its IAM policy.
# ATTACHMENTS_S3_BUCKET=workloom-private
# ATTACHMENTS_S3_REGION=us-east-1
# Omit endpoint for AWS; otherwise use the provider's S3 API origin (HTTPS in hosted mode).
# ATTACHMENTS_S3_ENDPOINT=https://storage.example.com
# ATTACHMENTS_S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=<server-only-access-key>
# AWS_SECRET_ACCESS_KEY=<server-only-secret-key>
# AWS_SESSION_TOKEN=<optional-temporary-session-token>
# ATTACHMENTS_SIGNED_URL_TTL_SECONDS=3600  # allowed: 60..7200
