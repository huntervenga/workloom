{
  "name": "@workloom/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workloom PostgreSQL schema, reviewed migrations, synthetic demo seed and domain port adapters.",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:queue:migrate": "tsx src/cli/queue-migrate.ts",
    "db:seed:demo": "tsx src/cli/seed-demo.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@workloom/contracts": "*",
    "@workloom/domain": "*",
    "drizzle-orm": "^0.45.4",
    "pg-boss": "12.38.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@workloom/config": "*",
    "drizzle-kit": "^0.31.4"
  }
}
