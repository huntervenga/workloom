{
  "name": "@workloom/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Workloom DTOs and Zod schemas for client and server",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
