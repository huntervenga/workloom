{
  "name": "@workloom/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workloom background job worker (pg-boss): runs domain commands from queued jobs.",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@workloom/contracts": "*",
    "@workloom/db": "*",
    "@workloom/domain": "*",
    "drizzle-orm": "^0.45.4",
    "pg-boss": "12.38.0"
  },
  "devDependencies": {
    "@workloom/config": "*"
  }
}
