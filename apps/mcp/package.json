{
  "name": "@workloom/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP adapter; loopback HTTP only, no database access.",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@workloom/contracts": "*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@workloom/config": "*"
  }
}
