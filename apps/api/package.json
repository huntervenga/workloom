{
  "name": "@workloom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workloom HTTP adapter (Fastify): /api/v1, health checks, dev identity adapter and optimized web static serving.",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "NODE_ENV=development tsx watch src/main.ts",
    "start": "NODE_ENV=production node dist/main.js",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@workloom/contracts": "*",
    "@workloom/db": "*",
    "@workloom/domain": "*",
    "fastify": "^5.6.1",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@workloom/config": "*"
  }
}
